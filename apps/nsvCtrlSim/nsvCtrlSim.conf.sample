# Sample MagAO-X config for nsvCtrlSim
# Install as /opt/MagAOX/config/nsv455sim.conf (process name from proclist)
#
# Mode sections MUST include configFile= (any placeholder) — required by
# stdCamera::loadCameraConfig — plus centerX/Y, sizeX/Y, maxFPS.

[framegrabber]
shmimName=nsv455
circBuffLength=2

[camera]
startupMode=9576x6388
default_h=6388
default_w=9576
default_x=4788
default_y=3194
bitDepth=16
# Kept for config compatibility; does not cap exptime.
readoutOverhead_ns=100

[9576x6388]
configFile=dummy
centerX=4788
centerY=3194
sizeX=9576
sizeY=6388
maxFPS=4

[8096x6324]
configFile=dummy
centerX=4048
centerY=3162
sizeX=8096
sizeY=6324
maxFPS=4

[4096x4096]
configFile=dummy
centerX=2048
centerY=2048
sizeX=4096
sizeY=4096
maxFPS=6

[2048x2048]
configFile=dummy
centerX=1024
centerY=1024
sizeX=2048
sizeY=2048
maxFPS=12

[1024x1024]
configFile=dummy
centerX=512
centerY=512
sizeX=1024
sizeY=1024
maxFPS=23

[512x512]
configFile=dummy
centerX=256
centerY=256
sizeX=512
sizeY=512
maxFPS=44

[256x256]
configFile=dummy
centerX=128
centerY=128
sizeX=256
sizeY=256
maxFPS=83

[128x128]
configFile=dummy
centerX=64
centerY=64
sizeX=128
sizeY=128
maxFPS=133
