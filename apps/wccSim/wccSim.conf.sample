# Sample MagAO-X config for wccSim, the WCC all-sky sensor array simulator.
# Install as /opt/MagAOX/config/wccsim.conf (process name comes from the proclist).
#
# wccSim publishes one ImageStreamIO stream per sensor, at that sensor's own
# commanded frame rate, exposure time and region of interest. It follows each
# camera over INDI, so reconfiguring a camera reconfigures the simulation.
#
# Numbers below are a LAZULI-like wide field guider array. The plate scale that
# results from telescope.diameter and telescope.f_number is
#   3.76 um / (12 * 6.5 m) * 206265 = 0.00994 arcsec/pixel
# so a 9576 pixel IMX sensor spans about 95 arcsec and the sensors sit hundreds
# of arcsec apart in field angle, matching the X_WCC and Y_WCC columns of the
# visit file.

[telescope]
diameter=6.5
f_number=12.0
central_obscuration=0.0
spider_vanes=0
spider_width=0.0
# WCC focal plane X runs opposite to increasing right ascension.
parity=-1
throughput=0.5

[catalog]
# The catalog is instrument calibration data, not source, so it is not carried in
# this repository. Install it under /opt/MagAOX/calib/wcc/ and point here.
path=/opt/MagAOX/calib/wcc/gsc31_north.csv
mag_column=mag
id_column=gsc2ID
# Sources fainter than this are dropped at load, which keeps the cone searches short.
mag_limit=21

[pointing]
# High-rate pointing is a 4x1xN double shmim (ra, dec, pa [deg], sim_time [s])
# written by telescopeSim. An exposure of T seconds integrates the ticks whose
# simulated times fall in [now - T, now], where now is the newest slice's
# sim-time — not the computer clock. The nsv camera fps does not run in real
# time, so a wall-clock window would park the PSF on the last sample.
#
# Leave shmim empty to render from the 1 Hz INDI pointing (or local commands if
# tel_device is also empty). write_hz must match telescopeSim.
shmim=telpointing
# Pointing tick rate in Hz of simulated time, not wall-clock. Each telescopeSim
# write is one tick of duration 1/write_hz. 5000 Hz means a 1 s exposure
# integrates 5000 mount samples. Must match telescopeSim's pointing.write_hz.
write_hz=5000
# Keep every pointing tick (0). The renderer histograms ticks into PSF-bank
# cells (see psf_substeps) so a 5000 Hz trail is one splat per occupied cell,
# not 5000 stamp placements per star. A positive value time-averages the trail
# before rendering; leave 0 unless you are debugging.
max_samples=0
#
# INDI telescope device. Used as a 1 Hz fallback and for status. For MagAO-X
# tcsInterface instead use:
#   tel_property=telpos
#   tel_pa_element=rotoff
tel_device=telescopesim
tel_property=pointing
tel_ra_element=ra
tel_dec_element=dec
tel_pa_element=pa
# Startup boresight. This is the gsc31_north.csv field centre.
ra=192.317
dec=26.84316038
pa=0.0

[sim]
sensors=IMX-18,IMX-19,IMX-21,HWK-08,HWK-09
# Pupil sampling for the diffraction calculation. Larger is more faithful and
# much slower to start; the PSF itself does not change much above 256.
npix_pupil=256
# PSF postage stamp size. 48 covers the core and first rings at this plate scale.
psf_samples=48
# Sub-pixel bins per axis of the PSF bank. This is the spatial resolution of the
# science trail: each pointing tick is quantized onto this grid, then ticks that
# share a cell are coalesced. Worst placement error is 0.5/psf_substeps pixels
# (8 → 0.0625 px). Raising it makes a long exposure's path finer and startup
# slower (banks scale as psf_substeps²). The dwell-map shmim is the camera frame
# size with a 1 at every detector pixel that hosted a bank cell, so overlay it
# on shmim_out to see the path; finer substeps change which cells (and therefore
# which pixels) are occupied.
psf_substeps=8
star_margin=1.0
# off  : signal plus pedestals only, fastest and fully repeatable
# read  : adds Gaussian read noise over the whole frame
# full  : adds Poisson shot noise on illuminated pixels as well
# A full 61 megapixel frame costs roughly 0.3 s in full mode, so full frame
# acquisition above a few Hz needs read or off.
noise_mode=full
bias=100
seed=20260909
circ_buff_length=1
default_fps=4
default_exp_time=1.0
start_streaming=false
# Publish a same-size occupancy shmim per sensor (shmim_out + "dwell", e.g.
# nsv18simdwell). Pixels are 0 except 1 at each (x,y) a PSF stamp was placed, so
# you can overlay it on the camera stream and see the trail. Set false to skip.
dwell_map=true

#-----------------------------------------------------------------------------
# One section per sensor. The name must match an entry in sim.sensors, and must
# match the corresponding section in wccCtrl's configuration.
#
# field_x and field_y are the boresight relative field angles of the sensor
# optical centre in arcseconds, the same convention as X_WCC and Y_WCC in the
# visit file.
#-----------------------------------------------------------------------------

[IMX-18]
indi_device=nsv18
shmim_out=nsv18sim
# Optional occupancy stream; defaults to shmim_out + "dwell" (nsv18simdwell).
# shmim_dwell=nsv18simdwell
pixel_size=3.76
full_w=9576
full_h=6388
field_x=-849.953
field_y=-68.782
rotation=0.0
filter=SLOANR
bandwidth=0.150
pivot_wavelength=650
dark_current=0.05
read_noise=1.2
quantum_efficiency=0.8
full_well=65535
# Analog gain: camera emgain is a code 0-255, 0.1 dB per step, multiplying electrons.
conversion_gain=1.0
gain_step_db=0.1
gain_code_max=255

[IMX-19]
indi_device=nsv19
shmim_out=nsv19sim
pixel_size=3.76
full_w=9576
full_h=6388
field_x=-666.282
field_y=-109.310
rotation=0.0
filter=SLOANR
bandwidth=0.150
pivot_wavelength=650
dark_current=0.05
read_noise=1.2
quantum_efficiency=0.8
full_well=65535
# Analog gain: camera emgain is a code 0-255, 0.1 dB per step, multiplying electrons.
conversion_gain=1.0
gain_step_db=0.1
gain_code_max=255

