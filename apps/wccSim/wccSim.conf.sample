rotation=0.0
filter=SLOANR
bandwidth=0.150
pivot_wavelength=650
dark_current=0.05
read_noise=1.2
quantum_efficiency=0.8
full_well=65535
# Analog gain: camera emgain is a code 0-255, 0.1 dB per step, multiplying electrons.
conversion_gain=1.0
gain_step_db=0.1
gain_code_max=255

[HWK-08]
indi_device=hwk08
shmim_out=hwk08sim
pixel_size=4.6
full_w=4096
full_h=2300
field_x=786.510
field_y=102.092
rotation=0.0
filter=SLOANR
bandwidth=0.150
pivot_wavelength=650
dark_current=0.05
read_noise=0.28
quantum_efficiency=0.7
full_well=65535
# Analog gain: camera emgain is a code 0-255, 0.1 dB per step, multiplying electrons.
conversion_gain=1.0
gain_step_db=0.1
gain_code_max=255

[HWK-09]
indi_device=hwk09
shmim_out=hwk09sim
pixel_size=4.6
