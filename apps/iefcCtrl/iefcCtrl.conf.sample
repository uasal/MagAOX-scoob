# Sample MagAO-X config for iefcCtrl
# Install as /opt/MagAOX/config/iefc.conf (process name from proclist)

[iefc]
# Milk / ImageStreamIO names (also exposed as INDI text props under group "shmims")
# For sim with llowfscSim, use shm_cam_input=camsci_sim (camera's own stream is separate).
shm_cam_input=camsci
shm_dm=dm01disp07

# INDI device name of the science camera. Set exposure/gain on that device:
#   setINDI nsvsim.exptime.target=0.01
#   setINDI nsvsim.emgain.target=120
# iefcCtrl only stores cam_name.exptime.current / emgain.current for dark matching.
cam_name=camsci

# Paths:
#   cal_dir — calibration package (response/control matrices from calibrate; used by cl_run)
#   dm_cmd_path — closed-loop DM command FITS archive ({shm_dm}_cl_{N}.fits)
#   psf_dir — ref-PSF / Imax package (from psfRefCtrl; loaded by reload_psf_ref / calibrate / cl_run)
#   dark_lib_path — dark library from darkCtrl (dark_metadata.txt + dark_NNN.fits)
# NOTE: PSF acquisition is now in psfRefCtrl (take_ref). Use reload_psf_ref here to reload the package.
cal_dir=./cal_a
dm_cmd_path=./dm_cmds
psf_dir=./ref_psf
dark_lib_path=/opt/MagAOX/data/darks/camsci
# External FITS mask for dh_mask_reload (sets control+contrast; remasks cal_dir if present).
# Empty → falls back to cal_dir/wfs_mask.fits on dh_mask_reload.
#dh_mask_path=./my_dh_mask.fits
# Saturation-check region for calibrate (raw ADU before dark/normalize). Published to shm_sat_mask.
#sat_mask_path=./sat_mask.fits
sat_thresh=55000

# Frames averaged per grab for calibrate, cl_run, and contrast / shm_cam_sub_norm.
n_images=10
# Camera settle after DM write: use ONE of these (mutually exclusive).
# Frame delay wins if both are non-zero.
cam_n_frame_delay=1
cam_r_delay=0.0

# Calibration
cal_reg_cond=-2.5
cal_probe_amp=5e-9
cal_mode_amp=2e-9

# Closed-loop run (cl_*)
cl_probe_amp=1e-9
cl_iters=3
cl_loop_gain=1.0
cl_leakage=0.0
# dm_reset loads {dm_cmd_path}/{shm_dm}_cl_{dm_reset_index}.fits and sets cl_index to that value.
# Subsequent cl_run writes overwrite cl_{index+1}, cl_{index+2}, ...
dm_reset_index=0

# Full-frame response cube (multi-GB). Keep true to remask via dh_mask_reload after restart.
save_response_full=true

[shmims]
shm_cam_sub_norm=camsci_sub_norm
shm_contrast_avg=contrast_avg
shm_dh_mask=iefc_mask
shm_sat_mask=iefc_sat_mask
