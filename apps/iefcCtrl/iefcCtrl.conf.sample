# Sample MagAO-X config for iefcCtrl
# Install as /opt/MagAOX/config/iefc.conf (process name from proclist)

[iefc]
# Milk / ImageStreamIO names (also exposed as INDI text props under group "shmims")
shm_cam_input=camsci
dm_shmim=dm01disp07
fsm_shmim=dm00disp01
# shutterShmim INDI text = milk name below; shutter INDI toggle = open/closed (On=closed)
shutter=camscishutter
cam_exp_shmim=camsciexptime
cam_gain_shmim=camscigain

# Live camera exposure / gain (INDI: cam_exp, cam_gain) write the milk channels above.
cam_exp=1.0
cam_gain=0.0
# Ref-PSF exposure / gain (INDI: cal_psf_exp, cal_psf_gain) applied at start of doRefPsf.
cal_psf_exp=1.0
cal_psf_gain=0.0

# Paths (alphabetically grouped under dir_*):
#   dir_cal — calibration package (response/control matrices from doCalibrate; used by doRun)
#   dir_psf — ref-PSF / dark / Imax package (written by doRefPsf/doDarkLibrary; read by calibrate/run)
dir_cal=./cal_a
dir_psf=./ref_psf
# External FITS mask for loadWfsMask (sets control+contrast; remasks dir_cal if present).
# Empty → falls back to dir_cal/wfs_mask.fits on loadWfsMask.
#wfs_mask_path=./my_wfs_mask.fits
# Saturation-check region for calibrate (raw ADU before dark/normalize). Published to iefc_sat_mask.
#sat_mask_path=./sat_mask.fits
sat_thresh=55000

nFrames=5
# Camera settle after DM write: use ONE of these (mutually exclusive).
# Frame delay wins if both are non-zero.
cam_n_frame_delay=1
cam_r_delay=0.0

fsmAmp_nm=1000
nDark=20
nPsf=20
exptimes=0.5,1,2,5

# Calibration
cal_reg_cond=-2.5
cal_probe_amp=5e-9
cal_mode_amp=2e-9

# Closed-loop run (cl_*)
cl_probe_amp=1e-9
cl_iters=3
cl_loop_gain=1.0
cl_leakage=0.0

# Average this many NI frames, then compute contrast (mask ∩ NI>0 mean).
# Larger N → slower contrast_avg update cadence.
contrast_avg_n=10
# Full-frame response cube (multi-GB). Keep true to remask via loadWfsMask after restart.
save_response_full=true

[shmims]
shm_cam_sub_norm=camsci_sub_norm
contrast_avg=contrast_avg
iefc_mask=iefc_mask
iefc_sat_mask=iefc_sat_mask
